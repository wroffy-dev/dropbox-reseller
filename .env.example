# =============================================================================
# Dropbox Reseller — environment configuration
# =============================================================================
# Works for all three deployment targets:
#   • Local development  — copy to .env and fill in what you need
#   • Docker / Coolify   — supply as a .env file or Coolify environment variables
#   • Azure Container Apps — set under Containers → Environment variables, with
#     everything marked SECRET stored as a Container App secret
#
# Never commit a filled-in copy of this file. Never put a real secret here.
#
# Azure deployment guide:   docs/AZURE-DEPLOYMENT.md
# Copy-paste Azure values:  docs/AZURE-ENVIRONMENT.md
# =============================================================================


# -----------------------------------------------------------------------------
# Core — required in production. The app refuses to start without these.
# -----------------------------------------------------------------------------

# SECRET. PostgreSQL connection string.
#   Local:  postgresql://postgres:postgres@localhost:5432/dropbox_reseller?schema=public
#   Azure:  postgresql://USER:PASSWORD@SERVER.postgres.database.azure.com:5432/dropbox_reseller?schema=public&sslmode=require
# `sslmode=require` is mandatory on Azure — the server rejects plaintext.
# On Azure also append &connection_limit=5 (see docs/AZURE-DEPLOYMENT.md):
# several replicas each hold their own pool, and a small server allows few
# connections in total.
DATABASE_URL=""

# SECRET. Signs session tokens. At least 16 characters; 32+ recommended.
#   openssl rand -base64 32
# Changing this signs everyone out. It does NOT affect MFA enrolment.
AUTH_SECRET=""

# The full public URL, no trailing slash. Used for callbacks and email links.
# Start with the Azure-provided URL, then change both URLs to your domain once
# it is connected, and create a new revision.
NEXTAUTH_URL="http://localhost:3000"

# The same value, exposed to the browser for canonical URLs and Open Graph tags.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# SECRET. Encrypts integration secrets (SMTP passwords saved in the admin) at
# rest. At least 32 characters.
#   openssl rand -base64 32
ENCRYPTION_KEY=""


# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

# Azure Container Apps must have its target port set to this value.
PORT=3000

# Applies pending migrations on container start. Leave true: it only ever runs
# `prisma migrate deploy`, which applies existing migrations and never resets.
RUN_MIGRATIONS=true

# Runs the seed on container start. Keep false. Set it to true for ONE
# deployment to create the first admin, then set it back to false — see below.
RUN_SEED=false


# -----------------------------------------------------------------------------
# First-admin bootstrap
# -----------------------------------------------------------------------------
# Only read when RUN_SEED=true. Safe to re-run: an account that already exists
# is never given a new password and never recreated.
#
# AFTER THE FIRST DEPLOYMENT:
#   1. Sign in and complete Microsoft Authenticator enrolment.
#   2. Set RUN_SEED=false.
#   3. Delete SEED_ADMIN_PASSWORD from the environment.
#   4. Create a new revision.

SEED_ADMIN_EMAIL=""

# SECRET. Rejected unless it has 14+ characters, upper and lower case, a number,
# a symbol, and no common word such as "password" or "changeme".
SEED_ADMIN_PASSWORD=""

SEED_ADMIN_NAME="Super Admin"

# Demo pages, products, blog posts and sample leads. Leave false for any real
# site — this is development sample data.
SEED_DEMO_CONTENT=false


# -----------------------------------------------------------------------------
# Email (SMTP)
# -----------------------------------------------------------------------------
# Optional. Can also be configured at Admin → Settings → Email, and values
# stored there take precedence over these. Set SMTP_HOST to enable.

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
# SECRET.
SMTP_PASSWORD=""
# none | tls | ssl
SMTP_ENCRYPTION="tls"
MAIL_FROM="Dropbox Reseller <noreply@example.com>"


# -----------------------------------------------------------------------------
# Media storage
# -----------------------------------------------------------------------------
# local | s3 | r2
#
# Use "local" for development and for Docker/Coolify with a persistent volume.
#
# Azure Container Apps MUST use "r2" or "s3". The container filesystem is
# ephemeral and is not shared between replicas: a file uploaded through replica A
# would be missing on replica B and gone at the next deployment.
STORAGE_PROVIDER="local"

# Local provider only.
LOCAL_UPLOAD_DIR="public/uploads"

# Cloudflare R2: https://<account-id>.r2.cloudflarestorage.com
# AWS S3: leave empty.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
# SECRET.
S3_ACCESS_KEY=""
# SECRET.
S3_SECRET_KEY=""
# The public base URL that serves the bucket — an R2 public domain or a CDN.
S3_PUBLIC_URL=""
# true for R2 and MinIO; false for AWS S3.
S3_FORCE_PATH_STYLE="true"

# Maximum upload size in kilobytes.
MAX_UPLOAD_KB="150"


# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
# Admin → Marketing overrides these at runtime.
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""


# -----------------------------------------------------------------------------
# Backup & restore
# -----------------------------------------------------------------------------
# local | s3
#
# Azure Container Apps MUST use "s3" — a backup written to the container
# filesystem is destroyed by the next deployment.
BACKUP_STORAGE_DRIVER="local"

# Local driver only. Must be a persistent volume on Docker/Coolify.
BACKUP_LOCAL_PATH="/app/backups"

# Use a PRIVATE bucket, SEPARATE from the media bucket. A backup archive
# contains the entire database.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
# SECRET.
BACKUP_S3_ACCESS_KEY_ID=""
# SECRET.
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_FORCE_PATH_STYLE="true"

# How many automatic backups to keep per tier. Manual, imported and pre-restore
# safety backups are never pruned.
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="4"
BACKUP_RETENTION_MONTHLY="3"

# Largest archive the import endpoint accepts, in megabytes.
BACKUP_MAX_IMPORT_MB="2048"

# SECRET. Reserved for encrypted archives (see docs/BACKUP-RESTORE.md). Leave
# empty unless you have somewhere safe to keep the key.
BACKUP_ENCRYPTION_KEY=""

# SECRET. Shared secret for POST /api/internal/cron/backup, sent as
# `Authorization: Bearer <value>`. At least 16 characters; when unset the
# endpoint is disabled rather than open.
#   openssl rand -hex 32
CRON_SECRET=""


# -----------------------------------------------------------------------------
# Two-factor authentication (Microsoft Authenticator)
# -----------------------------------------------------------------------------

# Shown in the authenticator app as the account issuer.
MFA_ISSUER="Dropbox Reseller"

# SECRET. Encrypts TOTP secrets at rest and keys the recovery-code hashes.
# REQUIRED in production — without it nobody can enrol.
#   openssl rand -base64 32
#
# WARNING: changing this after users have enrolled makes every stored TOTP
# secret and every recovery code permanently unreadable. Every user would have
# to enrol again, and there is no recovery procedure. Treat it as permanent,
# keep it out of backups, and store it with your disaster-recovery notes — a
# database restored onto a deployment with a different key cannot decrypt its
# own MFA secrets.
MFA_ENCRYPTION_KEY=""
