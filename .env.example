# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# PostgreSQL connection string
DATABASE_URL="postgresql://dropbox:dropbox@localhost:5432/dropbox_reseller?schema=public"

# Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public base URL of the deployment (used by Auth.js, sitemap, canonicals, emails)
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 32-byte key used to encrypt secrets at rest (SMTP password).
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# ---------------------------------------------------------------------------
# Initial administrator (used by `npm run db:seed` only — never in production data)
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD=""
SEED_ADMIN_NAME="Super Admin"
# Set to "true" to also seed demo pages/products/blog posts
SEED_DEMO_CONTENT="true"

# ---------------------------------------------------------------------------
# SMTP (can also be configured from Admin → Settings → Email; DB values win)
# ---------------------------------------------------------------------------
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_ENCRYPTION="tls"
MAIL_FROM="Dropbox Reseller <noreply@example.com>"

# ---------------------------------------------------------------------------
# Storage — local | s3 | r2
# ---------------------------------------------------------------------------
STORAGE_PROVIDER="local"
# Local provider only: files are written under ./public/uploads
LOCAL_UPLOAD_DIR="public/uploads"

# S3 / Cloudflare R2
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""
# Public base URL that serves the bucket (CDN or R2 public domain)
S3_PUBLIC_URL=""
S3_FORCE_PATH_STYLE="true"

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
# Maximum upload size in kilobytes. Defaults to 150 KB if unset.
MAX_UPLOAD_KB="150"

# ---------------------------------------------------------------------------
# Optional build-time analytics fallbacks (Admin → Marketing overrides these)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GA_ID=""
NEXT_PUBLIC_GTM_ID=""

# ---------------------------------------------------------------------------
# Backup & restore
# ---------------------------------------------------------------------------
# Where backup archives are written: local | s3
# "local" writes to BACKUP_LOCAL_PATH, which MUST be a persistent volume in
# production — a container filesystem is replaced on every deploy.
BACKUP_STORAGE_DRIVER="local"
BACKUP_LOCAL_PATH="/app/backups"

# S3 / Cloudflare R2 for off-site archives. Use a PRIVATE bucket, separate from
# the media bucket: these archives contain the whole database.
BACKUP_S3_ENDPOINT=""
BACKUP_S3_REGION="auto"
BACKUP_S3_BUCKET=""
BACKUP_S3_ACCESS_KEY_ID=""
BACKUP_S3_SECRET_ACCESS_KEY=""
BACKUP_S3_FORCE_PATH_STYLE="true"

# How many automatic backups to keep per tier. Manual, imported and pre-restore
# safety backups are never pruned.
BACKUP_RETENTION_DAILY="7"
BACKUP_RETENTION_WEEKLY="4"
BACKUP_RETENTION_MONTHLY="3"

# Largest archive the import endpoint accepts, in megabytes.
BACKUP_MAX_IMPORT_MB="2048"

# Reserved for encrypted archives (see docs/BACKUP-RESTORE.md). Leave empty
# unless you have somewhere safe to keep the key: lose it and the archives
# encrypted with it are unreadable.
BACKUP_ENCRYPTION_KEY=""

# Shared secret for POST /api/internal/cron/backup, sent as
# `Authorization: Bearer <value>`. Must be at least 16 characters; when unset
# the endpoint is disabled rather than open. Generate with:
#   openssl rand -hex 32
CRON_SECRET=""
