model EmailSettings {
  id String @id @default("singleton")

  host       String?
  port       Int     @default(587)
  username   String?
  password   String? // encrypted at rest; never sent to the client
  encryption String  @default("tls") // none | tls | ssl
  fromName   String  @default("Dropbox Reseller")
  fromEmail  String?
  replyTo    String?

  notifyOnNewLead         Boolean @default(true)
  notifyOnAssignment      Boolean @default(true)
  notifyOnSubmission      Boolean @default(false)
  salesNotificationEmails String? @db.Text // comma-separated

